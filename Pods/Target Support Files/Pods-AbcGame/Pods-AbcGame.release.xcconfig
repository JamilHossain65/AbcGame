ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK" "${PODS_CONFIGURATION_BUILD_DIR}/Protobuf" "${PODS_ROOT}/Appodeal/Appodeal-4.3.0" "${PODS_ROOT}/AppodealGoogleAdMobAdapter/APDGoogleAdMobAdapter-13.5.0.0" "${PODS_ROOT}/Bidon/Bidon-0.15.0" "${PODS_ROOT}/Google-Mobile-Ads-SDK/Frameworks/GoogleMobileAdsFramework" "${PODS_ROOT}/GoogleUserMessagingPlatform/Frameworks/Release" "${PODS_ROOT}/StackConsentManager" "${PODS_ROOT}/StackModules/release/Static" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Appodeal" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Bidon" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Google-Mobile-Ads-SDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleUserMessagingPlatform" "${PODS_XCFRAMEWORKS_BUILD_DIR}/StackConsentManager" "${PODS_XCFRAMEWORKS_BUILD_DIR}/StackModules/Core-Static" "${PODS_XCFRAMEWORKS_BUILD_DIR}/StackModules/ProductPresentation-Static" "${PODS_XCFRAMEWORKS_BUILD_DIR}/StackModules/Rendering-Static"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1 $(inherited) GPB_USE_PROTOBUF_FRAMEWORK_IMPORTS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK/Google_Mobile_Ads_SDK.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Protobuf/Protobuf.framework/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AppodealGoogleAdMobAdapter/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_XCFRAMEWORKS_BUILD_DIR}/AppodealGoogleAdMobAdapter" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"APDGoogleAdMobAdapter" -l"ObjC" -l"sqlite3" -l"z" -framework "AVFoundation" -framework "AdSupport" -framework "Appodeal" -framework "AppodealMediationCore" -framework "AudioToolbox" -framework "Bidon" -framework "CFNetwork" -framework "CoreGraphics" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreTelephony" -framework "CoreVideo" -framework "GoogleMobileAds" -framework "Google_Mobile_Ads_SDK" -framework "ImageIO" -framework "JavaScriptCore" -framework "MediaPlayer" -framework "MessageUI" -framework "MobileCoreServices" -framework "Network" -framework "Protobuf" -framework "QuartzCore" -framework "SafariServices" -framework "Security" -framework "StackConsentManager" -framework "StackModules" -framework "StackProductPresentation" -framework "StackRendering" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -framework "UserMessagingPlatform" -framework "WebKit" -weak_framework "AdSupport" -weak_framework "JavaScriptCore" -weak_framework "SafariServices" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Appodeal" "-F${PODS_CONFIGURATION_BUILD_DIR}/AppodealGoogleAdMobAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/Bidon" "-F${PODS_CONFIGURATION_BUILD_DIR}/Google-Mobile-Ads-SDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/GoogleUserMessagingPlatform" "-F${PODS_CONFIGURATION_BUILD_DIR}/Protobuf" "-F${PODS_CONFIGURATION_BUILD_DIR}/StackConsentManager" "-F${PODS_CONFIGURATION_BUILD_DIR}/StackModules"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
